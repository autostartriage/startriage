{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ubuntu Package Cache Schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "upstream": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "bug_tracker": { "type": "string", "format": "uri" },
          "vcs": { "type": "string", "format": "uri" }
        },
        "required": ["url", "bug_tracker", "vcs"]
      },
      "fedora": { "$ref": "#/definitions/distro_info" },
      "debian": { "$ref": "#/definitions/distro_info" }
    },
    "required": [],
    "additionalProperties": { "$ref": "#/definitions/distro_info" }
  },
  "definitions": {
    "distro_info": {
      "type": "object",
      "properties": {
        "source_package": { "type": ["string", "null"] },
        "bug_tracker": { "type": ["string", "null"], "format": "uri" }
      },
      "required": ["source_package", "bug_tracker"]
    }
  }
}
